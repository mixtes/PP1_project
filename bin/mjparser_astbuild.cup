package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:

	boolean errorDetected;
	
	Logger log = Logger.getLogger(getClass());
	
	public void report_fatal_error(String message, Object info) throws java.lang.Exception 
	{
		done_parsing();
		report_error(message, info);
	}
	
	public void syntax_error(Symbol cur_token) 
	{
		report_error("\nSintaksna greska", cur_token);
	}
	
	public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception
	{
		report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
	}
	
	public void report_error(String message, Object info)
	{
		errorDetected = true;
		StringBuilder msg = new StringBuilder(message);
		if (info instanceof Symbol)
			msg.append(" na liniji ").append(((Symbol)info).left);
		log.error(msg.toString());
	}

:}

terminal PRG, CNS;
terminal String IDT;
terminal Integer NUM, BOO;
terminal Character CHR;
terminal LOB, LCB, MOB, MCB, SCL, ASG, COM, SOB, SCB;
terminal ENM, CLS, EXT, ABS, VOI;
terminal SIF, ELS, BRK, CON, RET, RED, PRT, SWC, FOR;
terminal INC, DEC, LOR, AND, QSM, COL, MNS, PLS, MUL, DIV, MOD;
terminal NEW, DOT, LEN, CSE;
terminal EQL, NEQ, GRT, GRE, LET, LTE;

terminal WHL, SDO;

nonterminal Program Program;
nonterminal ProgramName ProgramName;
nonterminal DeclList DeclList;
nonterminal ConstDeclList ConstDeclList;
nonterminal VarDeclList VarDeclList;
nonterminal ClassDecl ClassDecl;
nonterminal EnumDeclList EnumDeclList;
nonterminal AbstractClassDecl AbstractClassDecl;
nonterminal MethodDeclList MethodDeclList;
nonterminal Type Type;
nonterminal ConstDecl ConstDecl;
nonterminal Constant Constant;
nonterminal AdditionalConstDecl AdditionalConstDecl;
nonterminal VarDecl VarDecl;
nonterminal VarList VarList;
nonterminal VarDeclListMultiple VarDeclListMultiple;
nonterminal EnumIDT EnumIDT;
nonterminal EnumName EnumName;
nonterminal AdditionalEnumIDT AdditionalEnumIDT;
nonterminal MethodDeclListOpt MethodDeclListOpt;
nonterminal ExtendsOpt ExtendsOpt;
nonterminal AbstractMethodDeclListOpt AbstractMethodDeclListOpt;
nonterminal AbstractMethodDeclList AbstractMethodDeclList;
nonterminal AbstractMethodDecl AbstractMethodDecl;
nonterminal MethodDecl MethodDecl;
nonterminal FormParsList FormParsList;
nonterminal FormParsAdditional FormParsAdditional;
nonterminal FormPar FormPar;
nonterminal FormParOpt FormParOpt;
nonterminal MethodDeclListPrgOpt MethodDeclListPrgOpt;
nonterminal Statement Statement;
nonterminal DesignatorStatement DesignatorStatement;
nonterminal StatementList StatementList;
nonterminal ElseOpt ElseOpt;
nonterminal ExpressionOpt ExpressionOpt;
nonterminal IfStart IfStart;
nonterminal ThenMarker ThenMarker;
nonterminal ElseMarker ElseMarker;
nonterminal OrConditionMarker OrConditionMarker;
nonterminal ForConditionStart ForConditionStart;
nonterminal ForUpdateStart ForUpdateStart;
nonterminal ForBodyStart ForBodyStart;
nonterminal TernaryTrueStart TernaryTrueStart;
nonterminal TernaryFalseStart TernaryFalseStart;
nonterminal CaseStart CaseStart;
nonterminal CaseEnd CaseEnd;
nonterminal NumConst NumConst;
nonterminal ForInit ForInit;
nonterminal SwitchInit SwitchInit;
nonterminal CaseList CaseList;
nonterminal CaseListOpt CaseListOpt;
nonterminal DesignatorStatementOpt DesignatorStatementOpt;
nonterminal ConditionOpt ConditionOpt;
nonterminal NumConstOpt NumConstOpt;
nonterminal StatementListOpt StatementListOpt;
nonterminal ActParsOpt ActParsOpt;
nonterminal ActPar ActPar;
nonterminal ActParsAdditional ActParsAdditional;
nonterminal ActParsListOpener ActParsListOpener;
nonterminal AssignOp AssignOp;
nonterminal Relop Relop;
nonterminal Addop Addop;
nonterminal Mulop Mulop;
nonterminal MinusOpt MinusOpt;
nonterminal DesignatorSuffix DesignatorSuffix;

nonterminal rs.etf.pp1.symboltable.concepts.Struct ExtensionFactor, Factor, FactorList, Term, TermList, SimpleExpression, Expression, Condition, CondFact, CondTerm;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Designator, DesignatorName, MethodTypeAndName, ClassName, AbsClassName;

nonterminal WhileInit WhileInit;
nonterminal WhileConditionStart WhileConditionStart;
nonterminal WhileBodyStart WhileBodyStart;
nonterminal ForeachBodyStart ForeachBodyStart;
nonterminal DoWhileInit DoWhileInit;
nonterminal DoWhileCondStart DoWhileCondStart;

precedence left ELS;

/* Program */

Program ::= 	(Program) PRG ProgramName:P1 DeclList:D2 LOB MethodDeclListPrgOpt:M3 LCB {: RESULT=new Program(P1, D2, M3); RESULT.setLine(P1left); :};

ProgramName ::= (ProgramName) IDT:I1 {: RESULT=new ProgramName(I1); RESULT.setLine(I1left); :};

DeclList ::= 	(DeclList_const) DeclList:D1 ConstDeclList:C2 {: RESULT=new DeclList_const(D1, C2); RESULT.setLine(D1left); :}
				|
				(DeclList_var) DeclList:D1 VarDeclList:V2 {: RESULT=new DeclList_var(D1, V2); RESULT.setLine(D1left); :}
				|
				(DeclList_class) DeclList:D1 ClassDecl:C2 {: RESULT=new DeclList_class(D1, C2); RESULT.setLine(D1left); :}
				|
				(DeclList_enum) DeclList:D1 EnumDeclList:E2 {: RESULT=new DeclList_enum(D1, E2); RESULT.setLine(D1left); :}
				|
				(DeclList_abstract_class) DeclList:D1 AbstractClassDecl:A2 {: RESULT=new DeclList_abstract_class(D1, A2); RESULT.setLine(D1left); :}
				|
				(DeclList_epsilon) {: RESULT=new DeclList_epsilon(); :} /* e */
				; 

/* ConstDecl */

ConstDeclList ::= (ConstDeclList) CNS Type:T1 ConstDecl:C2 AdditionalConstDecl:A3 SCL {: RESULT=new ConstDeclList(T1, C2, A3); RESULT.setLine(T1left); :};

ConstDecl ::= 	(ConstDecl) IDT:I1 ASG Constant:C2 {: RESULT=new ConstDecl(I1, C2); RESULT.setLine(I1left); :};

AdditionalConstDecl ::= (AdditionalConstDecl_recursion) COM ConstDecl:C1 AdditionalConstDecl:A2 {: RESULT=new AdditionalConstDecl_recursion(C1, A2); RESULT.setLine(C1left); :}
						|
						(AdditionalConstDecl_epsilon) {: RESULT=new AdditionalConstDecl_epsilon(); :} /* e */
						;

Constant ::= 	(Constant_num) NUM:N1 {: RESULT=new Constant_num(N1); RESULT.setLine(N1left); :}
				|
				(Constant_chr) CHR:C1 {: RESULT=new Constant_chr(C1); RESULT.setLine(C1left); :}
				|
				(Constant_boo) BOO:B1 {: RESULT=new Constant_boo(B1); RESULT.setLine(B1left); :}
				;

/* VarDecl */

VarDeclListMultiple ::= (VarDeclListMultiple_recursion) VarDeclListMultiple:V1 VarDeclList:V2 {: RESULT=new VarDeclListMultiple_recursion(V1, V2); RESULT.setLine(V1left); :}
							|
							(VarDeclListMultiple_epsilon) {: RESULT=new VarDeclListMultiple_epsilon(); :} /* e */
							;

VarDeclList ::= (VarDeclList_ok) Type:T1 VarList:V2 SCL {: RESULT=new VarDeclList_ok(T1, V2); RESULT.setLine(T1left); :}
				|
				(VarDeclList_err) error SCL {: RESULT=new VarDeclList_err(); :}
				;

VarList ::= (VarList_recursion) VarList:V1 COM VarDecl:V2 {: RESULT=new VarList_recursion(V1, V2); RESULT.setLine(V1left); :}
				|
				(VarList_single) VarDecl:V1 {: RESULT=new VarList_single(V1); RESULT.setLine(V1left); :}
				|
				(VarList_err_comma) VarList:V1 COM error {: RESULT=new VarList_err_comma(V1); RESULT.setLine(V1left); :}
				|
				(VarList_err_single) error {: RESULT=new VarList_err_single(); :}
				;
			
VarDecl ::= (VarDecl_array) IDT:I1 MOB MCB {: RESULT=new VarDecl_array(I1); RESULT.setLine(I1left); :}
				|
				(VarDecl_single) IDT:I1 {: RESULT=new VarDecl_single(I1); RESULT.setLine(I1left); :}
				;

/* EnumDecl */

EnumDeclList ::= (EnumDeclList) ENM EnumName:E1 LOB EnumIDT:E2 AdditionalEnumIDT:A3 LCB {: RESULT=new EnumDeclList(E1, E2, A3); RESULT.setLine(E1left); :};

EnumName ::= (EnumName) IDT:I1 {: RESULT=new EnumName(I1); RESULT.setLine(I1left); :};

EnumIDT ::= (EnumIDT_asg) IDT:I1 ASG NUM:N2 {: RESULT=new EnumIDT_asg(I1, N2); RESULT.setLine(I1left); :}
			|
			(EnumIDT_no_asg) IDT:I1 {: RESULT=new EnumIDT_no_asg(I1); RESULT.setLine(I1left); :}
			;

AdditionalEnumIDT ::= (AdditionalEnumIDT_recursion) COM EnumIDT:E1 AdditionalEnumIDT:A2 {: RESULT=new AdditionalEnumIDT_recursion(E1, A2); RESULT.setLine(E1left); :}
						|
						(AdditionalEnumIDT_epsilon) {: RESULT=new AdditionalEnumIDT_epsilon(); :} /* e */
						;

/* ClassDecl */

ClassDecl ::= (ClassDecl) CLS ClassName:C1 ExtendsOpt:E2 LOB VarDeclListMultiple:V3 MethodDeclListOpt:M4 LCB {: RESULT=new ClassDecl(C1, E2, V3, M4); RESULT.setLine(C1left); :};

ClassName ::= (ClassName) IDT:I1 {: RESULT=new ClassName(I1); RESULT.setLine(I1left); :};

ExtendsOpt ::= (ExtendsOpt_exists) EXT Type:T1 {: RESULT=new ExtendsOpt_exists(T1); RESULT.setLine(T1left); :}
				|
				(ExtendsOpt_epsilon) {: RESULT=new ExtendsOpt_epsilon(); :} /* e */
				|
				(ExtendsOpt_err) EXT error {: RESULT=new ExtendsOpt_err(); :}
				;

MethodDeclListOpt ::= (MethodDeclListOpt_exists) LOB MethodDeclList:M1 LCB {: RESULT=new MethodDeclListOpt_exists(M1); RESULT.setLine(M1left); :}
						|
						(MethodDeclListOpt_epsilon) {: RESULT=new MethodDeclListOpt_epsilon(); :} /* e */
						;

/* AbstractClassDecl */

AbstractClassDecl ::= (AbstractClassDecl) ABS CLS AbsClassName:A1 ExtendsOpt:E2 LOB AbstractMethodDeclListOpt:A3 LCB {: RESULT=new AbstractClassDecl(A1, E2, A3); RESULT.setLine(A1left); :};

AbsClassName ::= (AbsClassName) IDT:I1 {: RESULT=new AbsClassName(I1); RESULT.setLine(I1left); :};

AbstractMethodDeclListOpt ::= (AbstractMethodDeclListOpt_exists) LOB AbstractMethodDeclList:A1 LCB {: RESULT=new AbstractMethodDeclListOpt_exists(A1); RESULT.setLine(A1left); :}
								|
								(AbstractMethodDeclListOpt_epsilon) {: RESULT=new AbstractMethodDeclListOpt_epsilon(); :} /* e */
								;

AbstractMethodDeclList ::= (AbstractMethodDeclList_recursion_abs) AbstractMethodDeclList:A1 AbstractMethodDecl:A2 {: RESULT=new AbstractMethodDeclList_recursion_abs(A1, A2); RESULT.setLine(A1left); :}
							|
							(AbstractMethodDeclList_recursion_normal) AbstractMethodDeclList:A1 MethodDecl:M2 {: RESULT=new AbstractMethodDeclList_recursion_normal(A1, M2); RESULT.setLine(A1left); :}
							|
							(AbstractMethodDeclList_single_abs) AbstractMethodDecl:A1 {: RESULT=new AbstractMethodDeclList_single_abs(A1); RESULT.setLine(A1left); :}
							|
							(AbstractMethodDeclList_single_normal) MethodDecl:M1 {: RESULT=new AbstractMethodDeclList_single_normal(M1); RESULT.setLine(M1left); :}
							;

/* AbstractMethodDecl */

AbstractMethodDecl ::= (AbstractMethodDecl) ABS MethodTypeAndName:M1 SOB FormParsList:F2 SCB SCL {: RESULT=new AbstractMethodDecl(M1, F2); RESULT.setLine(M1left); :};

/* MethodDecl */

MethodDeclListPrgOpt ::= (MethodDeclListPrgOpt_exists) MethodDeclList:M1 {: RESULT=new MethodDeclListPrgOpt_exists(M1); RESULT.setLine(M1left); :} 
						|
						(MethodDeclListPrgOpt_epsilon) {: RESULT=new MethodDeclListPrgOpt_epsilon(); :} /* e */
						;

MethodDeclList ::= (MethodDeclList_recursion) MethodDeclList:M1 MethodDecl:M2 {: RESULT=new MethodDeclList_recursion(M1, M2); RESULT.setLine(M1left); :}
					|
					(MethodDeclList_single) MethodDecl:M1 {: RESULT=new MethodDeclList_single(M1); RESULT.setLine(M1left); :}
					;

MethodDecl ::= (MethodDecl) MethodTypeAndName:M1 SOB FormParsList:F2 SCB VarDeclListMultiple:V3 LOB StatementListOpt:S4 LCB {: RESULT=new MethodDecl(M1, F2, V3, S4); RESULT.setLine(M1left); :};

MethodTypeAndName ::= (MethodTypeAndName_void) VOI IDT:I1 {: RESULT=new MethodTypeAndName_void(I1); RESULT.setLine(I1left); :}
						|
						(MethodTypeAndName_type) Type:T1 IDT:I2 {: RESULT=new MethodTypeAndName_type(T1, I2); RESULT.setLine(T1left); :}
						;

StatementListOpt ::= (StatementListOpt_exists) StatementList:S1 {: RESULT=new StatementListOpt_exists(S1); RESULT.setLine(S1left); :}
					|
					(StatementListOpt_epsilon) {: RESULT=new StatementListOpt_epsilon(); :} /* e */
					;

StatementList ::= (StatementList_recursion) StatementList:S1 Statement:S2 {: RESULT=new StatementList_recursion(S1, S2); RESULT.setLine(S1left); :}
					|
					(StatementList_single) Statement:S1 {: RESULT=new StatementList_single(S1); RESULT.setLine(S1left); :}
					;

/* FormPars */

FormParsList ::= (FormParsList) FormParOpt:F1 {: RESULT=new FormParsList(F1); RESULT.setLine(F1left); :};

FormParOpt ::= (FormParOpt_exists) FormPar:F1 FormParsAdditional:F2 {: RESULT=new FormParOpt_exists(F1, F2); RESULT.setLine(F1left); :}
				|
				(FormParOpt_epsilon) {: RESULT=new FormParOpt_epsilon(); :} /* e */
				;

FormParsAdditional ::= (FormParsAdditional_recursion) COM FormPar:F1 FormParsAdditional:F2 {: RESULT=new FormParsAdditional_recursion(F1, F2); RESULT.setLine(F1left); :}
						|
						(FormParsAdditional_epsilon) {: RESULT=new FormParsAdditional_epsilon(); :} /* e */
						;

FormPar ::= (FormPar_array) Type:T1 IDT:I2 MOB MCB {: RESULT=new FormPar_array(T1, I2); RESULT.setLine(T1left); :}
			|
			(FormPar_single) Type:T1 IDT:I2 {: RESULT=new FormPar_single(T1, I2); RESULT.setLine(T1left); :}
			|
			(FormPar_err) error {: RESULT=new FormPar_err(); :}
			;

/* Type */

Type ::= 	(Type) IDT:I1 {: RESULT=new Type(I1); RESULT.setLine(I1left); :};

/* Statement */

Statement ::= (Statement_designator) DesignatorStatement:D1 SCL {: RESULT=new Statement_designator(D1); RESULT.setLine(D1left); :}
				|
				(Statement_if) IfStart:I1 SOB Condition:C2 SCB ThenMarker:T3 Statement:S4 ElseOpt:E5 {: RESULT=new Statement_if(I1, C2, T3, S4, E5); RESULT.setLine(I1left); :}
				|
				(Statement_if_err) IfStart:I1 SOB error SCB ThenMarker:T2 Statement:S3 ElseOpt:E4 {: RESULT=new Statement_if_err(I1, T2, S3, E4); RESULT.setLine(I1left); :}
				|
				(Statement_break) BRK SCL {: RESULT=new Statement_break(); :}
				|
				(Statement_continue) CON SCL {: RESULT=new Statement_continue(); :}
				|
				(Statement_return) RET ExpressionOpt:E1 SCL {: RESULT=new Statement_return(E1); RESULT.setLine(E1left); :}
				|
				(Statement_read) RED SOB Designator:D1 SCB SCL {: RESULT=new Statement_read(D1); RESULT.setLine(D1left); :}
				|
				(Statement_print) PRT SOB Expression:E1 NumConstOpt:N2 SCB SCL {: RESULT=new Statement_print(E1, N2); RESULT.setLine(E1left); :}
				|
				(Statement_switch) SwitchInit:S1 SOB Expression:E2 SCB LOB CaseListOpt:C3 LCB {: RESULT=new Statement_switch(S1, E2, C3); RESULT.setLine(S1left); :}
				|
				(Statement_for) ForInit:F1 SOB DesignatorStatementOpt:D2 SCL ForConditionStart:F3 ConditionOpt:C4 SCL ForUpdateStart:F5 DesignatorStatementOpt:D6 ForBodyStart:F7 SCB Statement:S8 {: RESULT=new Statement_for(F1, D2, F3, C4, F5, D6, F7, S8); RESULT.setLine(F1left); :}
				|
				(Statement_while) WhileInit:W1 SOB WhileConditionStart:W2 Condition:C3 WhileBodyStart:W4 SCB Statement:S5 {: RESULT=new Statement_while(W1, W2, C3, W4, S5); RESULT.setLine(W1left); :}
				|
				(Statement_do_while) DoWhileInit:D1 Statement:S2 WHL SOB DoWhileCondStart:D3 Condition:C4 SCB SCL {: RESULT=new Statement_do_while(D1, S2, D3, C4); RESULT.setLine(D1left); :}
				|
				(Statement_foreach) ForInit:F1 SOB Designator:D2 COL Designator:D3 SCB ForeachBodyStart:F4 Statement:S5 {: RESULT=new Statement_foreach(F1, D2, D3, F4, S5); RESULT.setLine(F1left); :}
				|
				(Statement_block) LOB StatementList:S1 LCB {: RESULT=new Statement_block(S1); RESULT.setLine(S1left); :}
				;

IfStart ::= (IfStart) SIF {: RESULT=new IfStart(); :};

ThenMarker ::= (ThenMarker) {: RESULT=new ThenMarker(); :} /* e */;

SwitchInit ::= (SwitchInit) SWC {: RESULT=new SwitchInit(); :};

ForInit ::= (ForInit) FOR {: RESULT=new ForInit(); :};

ForConditionStart ::= (ForConditionStart) {: RESULT=new ForConditionStart(); :} /* e */;

ForUpdateStart ::= (ForUpdateStart) {: RESULT=new ForUpdateStart(); :} /* e */;

ForBodyStart ::= (ForBodyStart) {: RESULT=new ForBodyStart(); :} /* e */;

WhileInit ::= (WhileInit) WHL {: RESULT=new WhileInit(); :};

WhileConditionStart ::= (WhileConditionStart) {: RESULT=new WhileConditionStart(); :} /* e */;

WhileBodyStart ::= (WhileBodyStart) {: RESULT=new WhileBodyStart(); :} /* e */;

ForeachBodyStart ::= (ForeachBodyStart) {: RESULT=new ForeachBodyStart(); :} /* e */;

DoWhileInit ::= (DoWhileInit) SDO {: RESULT=new DoWhileInit(); :};

DoWhileCondStart ::= (DoWhileCondStart) {: RESULT=new DoWhileCondStart(); :} /* e */;

ElseOpt ::= (ElseOpt_else) ElseMarker:E1 Statement:S2 {: RESULT=new ElseOpt_else(E1, S2); RESULT.setLine(E1left); :}
				|
				(ElseOpt_epsilon) {: RESULT=new ElseOpt_epsilon(); :} /* e */
				;

ElseMarker ::= (ElseMarker) ELS {: RESULT=new ElseMarker(); :};

ExpressionOpt ::= (ExpressionOpt_exists) Expression:E1 {: RESULT=new ExpressionOpt_exists(E1); RESULT.setLine(E1left); :}
					|
					(ExpressionOpt_epsilon) {: RESULT=new ExpressionOpt_epsilon(); :} /* e */
					;

CaseList ::= (CaseList_recursion) CSE NumConst:N1 COL CaseStart:C2 StatementListOpt:S3 CaseEnd:C4 CaseList:C5 {: RESULT=new CaseList_recursion(N1, C2, S3, C4, C5); RESULT.setLine(N1left); :}
				|
				(CaseList_single) CSE NumConst:N1 COL CaseStart:C2 StatementListOpt:S3 CaseEnd:C4 {: RESULT=new CaseList_single(N1, C2, S3, C4); RESULT.setLine(N1left); :}
				;

CaseListOpt ::= (CaseListOpt_exists) CaseList:C1 {: RESULT=new CaseListOpt_exists(C1); RESULT.setLine(C1left); :}
				|
				(CaseListOpt_epsilon) {: RESULT=new CaseListOpt_epsilon(); :} /* e */
				;

CaseStart ::= (CaseStart) {: RESULT=new CaseStart(); :} /* e */;

CaseEnd ::= (CaseEnd) {: RESULT=new CaseEnd(); :} /* e */;

NumConstOpt ::= (NumConstOpt_exists) COM NumConst:N1 {: RESULT=new NumConstOpt_exists(N1); RESULT.setLine(N1left); :}
					|
					(NumConstOpt_epsilon) {: RESULT=new NumConstOpt_epsilon(); :} /* e */
					;

NumConst ::= (NumConst) NUM:N1 {: RESULT=new NumConst(N1); RESULT.setLine(N1left); :};

DesignatorStatementOpt ::= (DesignatorStatementOpt_exists) DesignatorStatement:D1 {: RESULT=new DesignatorStatementOpt_exists(D1); RESULT.setLine(D1left); :}
								|
								(DesignatorStatementOpt_epsilon) {: RESULT=new DesignatorStatementOpt_epsilon(); :} /* e */
								;

ConditionOpt ::= (ConditionOpt_exists) Condition:C1 {: RESULT=new ConditionOpt_exists(C1); RESULT.setLine(C1left); :}
					|
					(ConditionOpt_epsilon) {: RESULT=new ConditionOpt_epsilon(); :} /* e */
					;
				
/* DesignatorStatement */

DesignatorStatement ::= (DesignatorStatement_assign) Designator:D1 AssignOp:A2 Expression:E3 {: RESULT=new DesignatorStatement_assign(D1, A2, E3); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_method) Designator:D1 SOB ActParsOpt:A2 SCB {: RESULT=new DesignatorStatement_method(D1, A2); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_inc) Designator:D1 INC {: RESULT=new DesignatorStatement_inc(D1); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_dec) Designator:D1 DEC {: RESULT=new DesignatorStatement_dec(D1); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_assign_err) Designator:D1 AssignOp:A2 error {: RESULT=new DesignatorStatement_assign_err(D1, A2); RESULT.setLine(D1left); :}
						;

/* ActPars */

ActParsOpt ::= (ActParsOpt_exist) ActParsListOpener:A1 ActPar:A2 ActParsAdditional:A3 {: RESULT=new ActParsOpt_exist(A1, A2, A3); RESULT.setLine(A1left); :}
				|
				(ActParsOpt_epsilon) ActParsListOpener:A1 {: RESULT=new ActParsOpt_epsilon(A1); RESULT.setLine(A1left); :}
				;

ActParsListOpener ::= (ActParsListOpener) {: RESULT=new ActParsListOpener(); :} /* e */;

ActParsAdditional ::= (ActParsAdditional_recursion) COM ActPar:A1 ActParsAdditional:A2 {: RESULT=new ActParsAdditional_recursion(A1, A2); RESULT.setLine(A1left); :}
						|
						(ActParsAdditional_epsilon) {: RESULT=new ActParsAdditional_epsilon(); :} /* e */ 
						;

ActPar ::= (ActPar) Expression:E1 {: RESULT=new ActPar(E1); RESULT.setLine(E1left); :};

/* Condition */

Condition ::= (Condition_single) CondTerm:C1 {: RESULT=new Condition_single(C1); RESULT.setLine(C1left); :}
				|
				(Condition_recursion) Condition:C1 LOR OrConditionMarker:O2 CondTerm:C3 {: RESULT=new Condition_recursion(C1, O2, C3); RESULT.setLine(C1left); :}
				;

OrConditionMarker ::= (OrConditionMarker) {: RESULT=new OrConditionMarker(); :} /* e */;

/* CondTerm */

CondTerm ::= (CondTerm_single) CondFact:C1 {: RESULT=new CondTerm_single(C1); RESULT.setLine(C1left); :} 
				|
				(CondTerm_recursion) CondTerm:C1 AND CondFact:C2 {: RESULT=new CondTerm_recursion(C1, C2); RESULT.setLine(C1left); :}
				;

/* CondFact */

CondFact ::= (CondFact_relop) SimpleExpression:S1 Relop:R2 SimpleExpression:S3 {: RESULT=new CondFact_relop(S1, R2, S3); RESULT.setLine(S1left); :}
				|
				(CondFact_single) SimpleExpression:S1 {: RESULT=new CondFact_single(S1); RESULT.setLine(S1left); :}
				;

/* Expression */

Expression ::= (Expression_termlist) SimpleExpression:S1 {: RESULT=new Expression_termlist(S1); RESULT.setLine(S1left); :}
				|
				(Expression_condition) Condition:C1 QSM TernaryTrueStart:T2 Expression:E3 COL TernaryFalseStart:T4 Expression:E5 {: RESULT=new Expression_condition(C1, T2, E3, T4, E5); RESULT.setLine(C1left); :}
				;

TernaryTrueStart ::= (TernaryTrueStart) {: RESULT=new TernaryTrueStart(); :} /* e */;

TernaryFalseStart ::= (TernaryFalseStart) {: RESULT=new TernaryFalseStart(); :} /* e */;

SimpleExpression ::= (SimpleExpression) TermList:T1 {: RESULT=new SimpleExpression(T1); RESULT.setLine(T1left); :};

/* Term */

TermList ::= (TermList_recursion) TermList:T1 Addop:A2 Term:T3 {: RESULT=new TermList_recursion(T1, A2, T3); RESULT.setLine(T1left); :}
				|
				(TermList_single) Term:T1 {: RESULT=new TermList_single(T1); RESULT.setLine(T1left); :}
				;

Term ::= (Term) FactorList:F1 {: RESULT=new Term(F1); RESULT.setLine(F1left); :};

/* Factor */

FactorList ::= (FactorList_recursion) FactorList:F1 Mulop:M2 ExtensionFactor:E3 {: RESULT=new FactorList_recursion(F1, M2, E3); RESULT.setLine(F1left); :}
					|
					(FactorList_single) ExtensionFactor:E1 {: RESULT=new FactorList_single(E1); RESULT.setLine(E1left); :}
					;

ExtensionFactor ::= (ExtensionFactor) MinusOpt:M1 Factor:F2 {: RESULT=new ExtensionFactor(M1, F2); RESULT.setLine(M1left); :};

MinusOpt ::= (MinusOpt_minus) MNS {: RESULT=new MinusOpt_minus(); :}
				|
				(MinusOpt_epsilon) {: RESULT=new MinusOpt_epsilon(); :} /* e */
				;

Factor ::= 	(Factor_designator_base) Designator:D1 {: RESULT=new Factor_designator_base(D1); RESULT.setLine(D1left); :}
			|
			(Factor_designator_method) Designator:D1 SOB ActParsOpt:A2 SCB {: RESULT=new Factor_designator_method(D1, A2); RESULT.setLine(D1left); :}
			|
			(Factor_constant_num) NUM:N1 {: RESULT=new Factor_constant_num(N1); RESULT.setLine(N1left); :}
			|
			(Factor_constant_chr) CHR:C1 {: RESULT=new Factor_constant_chr(C1); RESULT.setLine(C1left); :}
			|
			(Factor_constant_boo) BOO:B1 {: RESULT=new Factor_constant_boo(B1); RESULT.setLine(B1left); :}
			|
			(Factor_array) NEW Type:T1 MOB Expression:E2 MCB {: RESULT=new Factor_array(T1, E2); RESULT.setLine(T1left); :}
			|
			(Factor_object) NEW Type:T1 {: RESULT=new Factor_object(T1); RESULT.setLine(T1left); :}
			|
			(Factor_expression) SOB Expression:E1 SCB {: RESULT=new Factor_expression(E1); RESULT.setLine(E1left); :}
			;

/* Designator */

Designator ::= (Designator) DesignatorName:D1 DesignatorSuffix:D2 {: RESULT=new Designator(D1, D2); RESULT.setLine(D1left); :};

DesignatorName ::= (DesignatorName) IDT:I1 {: RESULT=new DesignatorName(I1); RESULT.setLine(I1left); :};

DesignatorSuffix ::= (DesignatorSuffix_array) DesignatorSuffix:D1 MOB Expression:E2 MCB {: RESULT=new DesignatorSuffix_array(D1, E2); RESULT.setLine(D1left); :}
					|
					(DesignatorSuffix_member) DesignatorSuffix:D1 DOT IDT:I2 {: RESULT=new DesignatorSuffix_member(D1, I2); RESULT.setLine(D1left); :}
					|
					(DesignatorSuffix_length) DesignatorSuffix:D1 DOT LEN {: RESULT=new DesignatorSuffix_length(D1); RESULT.setLine(D1left); :}
					|
					(DesignatorSuffix_epsilon) {: RESULT=new DesignatorSuffix_epsilon(); :} /* e */
					;

/* AssignOp */

AssignOp ::= (AssignOp) ASG {: RESULT=new AssignOp(); :};

/* Relop */

Relop ::= (Relop_eql) EQL {: RESULT=new Relop_eql(); :}
			|
			(Relop_neq) NEQ {: RESULT=new Relop_neq(); :}
			|
			(Relop_grt) GRT {: RESULT=new Relop_grt(); :}
			|
			(Relop_gre) GRE {: RESULT=new Relop_gre(); :}
			|
			(Relop_let) LET {: RESULT=new Relop_let(); :}
			|
			(Relop_lte) LTE {: RESULT=new Relop_lte(); :}
			;

/* Addop */

Addop ::= (Addop_pls) PLS {: RESULT=new Addop_pls(); :}
			|
			(Addop_mns) MNS {: RESULT=new Addop_mns(); :}
			;

/* Mulop */

Mulop ::= (Mulop_mul) MUL {: RESULT=new Mulop_mul(); :}
			|
			(Mulop_div) DIV {: RESULT=new Mulop_div(); :}
			|
			(Mulop_mod) MOD {: RESULT=new Mulop_mod(); :}
			;
