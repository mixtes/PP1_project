program test_303

const int cinilac = 4, delilac = 3;
abstract class AbsPredmet
{
	{
		abstract int zapremina();
		abstract int Q();
	}
}
class Predmet extends AbsPredmet
{
	int tezina;
	char vrsta;

	{
		int zapremina() {}
		int Q() {return zapremina() * tezina;}
	}
}

class Krug extends Predmet
{
	{
		int zapremina(int koeficijent) {return koeficijent * cinilac * delilac * delilac;}
	}
}

int zapreminaK, zapreminaS;
int tezinaK, tezinaS;
{		
	void main() Predmet predmeti[]; AbsPredmet absPredmeti[];
	{	
		
	}
